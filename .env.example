# Generate independent secrets with python3 scripts/setup.py. Never commit .env.
CORE_API_AUTH_USERNAME=admin
CORE_API_AUTH_PASSWORD=
CORE_API_AUTH_JWT_SECRET=
WOODY_ENCRYPTION_KEY=
WOODY_BOT_TOKEN=
WOODY_HTTP_PORT=8080
WOODY_ENCODER=x264
WOODY_ALLOW_TEST_SOURCES=0
# Optional existing absolute bind-mount paths; retain the old installation backup.
# WOODY_CORE_CONFIG=/opt/restreamer/config
# WOODY_CORE_DATA=/opt/restreamer/data
# Existing installations with RTMP authentication must include its token here.
# WOODY_OUTPUT_URI=rtmp://core:1935/live/woody-program?token=YOUR_TOKEN
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
